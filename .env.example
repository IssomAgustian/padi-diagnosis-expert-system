# Environment Variables Template for Padi Diagnosis Expert System
# Copy this file to .env and update with your actual values

# ==============================================
# FLASK BACKEND CONFIGURATION
# ==============================================
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=jwt-super-secret-key-change-in-production

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/padi_diagnosis
POSTGRES_DB=padi_diagnosis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AI Services Configuration (Choose one or both)
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=openai  # 'openai' or 'gemini'

# Rate Limiting
REDIS_URL=redis://localhost:6379/0

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# ==============================================
# NEXT.JS FRONTEND CONFIGURATION
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Padi Diagnosis Expert System
NEXT_PUBLIC_APP_DESCRIPTION=AI-powered rice disease diagnosis expert system

# Google OAuth (Frontend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================
# DEVELOPMENT OVERRIDES
# ==============================================
# For development, you can override production values here
# These are used when NODE_ENV=development

# Development database (if different from production)
# DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/padi_diagnosis_dev

# Development frontend URL
# DEV_FRONTEND_URL=http://localhost:3000

# Enable debug mode
# FLASK_DEBUG=1

# ==============================================
# SECURITY NOTES
# ==============================================
# 1. Change all secret keys before production deployment
# 2. Use strong, randomly generated secrets (at least 32 characters)
# 3. Never commit .env files to version control
# 4. Use environment-specific configurations in production
# 5. Enable HTTPS in production
# 6. Set up proper CORS origins in production

# ==============================================
# OPTIONAL CONFIGURATIONS
# ==============================================
# Email service for notifications (if implemented)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# File upload configuration (if implemented)
# MAX_FILE_SIZE=10485760  # 10MB
# UPLOAD_PATH=/app/uploads

# Monitoring and logging
# LOG_LEVEL=INFO
# SENTRY_DSN=your-sentry-dsn

# Analytics (if implemented)
# GOOGLE_ANALYTICS_ID=your-ga-id

# ==============================================
# DOCKER CONFIGURATION
# ==============================================
# These are used by docker-compose.yml
# Make sure they match your local setup

# Docker environment
# DOCKER_ENV=development
# COMPOSE_PROJECT_NAME=padi-diagnosis

# Docker networking
# DOCKER_NETWORK=padi-network
# DOCKER_POSTGRES_PORT=5432
# DOCKER_REDIS_PORT=6379
# DOCKER_BACKEND_PORT=5000
# DOCKER_FRONTEND_PORT=3000